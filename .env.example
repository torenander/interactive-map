# Local Supabase stack (npx supabase start / db reset). Values are the fixed
# defaults for the local dev stack, not secrets — see supabase/config.toml.
# Current values come from `npx supabase status -o env`; the anon key below
# may differ from that output (both work — same demo JWT secret).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTIwMH0.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Point at a hosted project instead by overriding both values in a real .env
# (never committed — see .gitignore).

# Optional. Unset (default) uses the same-origin /tiles/london.pmtiles used by
# local dev and every existing test. In production set this to the Supabase
# Storage public bucket URL for the pmtiles archive — see docs/DEPLOY.md.
# VITE_TILES_URL=https://<project-ref>.supabase.co/storage/v1/object/public/tiles/london.pmtiles
